# Copy to supabase/.env for local dev:  supabase functions serve --env-file supabase/.env
# Set in production with:               supabase secrets set --env-file supabase/.env

# Fallback list used only when the database has no merchants table rows (demo mode).
MERCHANTS=mock

# Ingest: a long random string. The scheduler sends it as header x-ingest-secret.
INGEST_SECRET=

# Offer reader fallback (optional). Without a key, unreadable banners go to the "Couldn't read" queue.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Cache (optional — falls back to in-memory per instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Amazon Associates India — Creators API (PA-API 5 is deprecated)
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_TOKEN_URL=

# Flipkart Affiliate
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Offer-banner scraping proxy (ScrapingBee-compatible)
SCRAPER_API_KEY=
SCRAPER_API_URL=
